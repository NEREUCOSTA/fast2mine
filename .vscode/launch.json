{   
    "version": "0.2.0",
    "configurations": [
    {
        "type": "robotframework-lsp",
        "name": "Robot Framework: Launch .robot file",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "target": "${file}",
        "terminal": "integrated",
        "env": {
            "PYDEVD_DISABLE_FILE_VALIDATION": "1"
        },
        "args": ["-Xfrozen_modules=off"]
    }
    ]
}